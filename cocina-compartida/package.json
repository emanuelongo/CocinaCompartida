{
  "name": "cocina-compartida",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "stagehand:install:browsers": "playwright install chromium",
    "stagehand:demo": "tsx stagehand/tests/observe-extract.e2e.ts",
    "stagehand:explore": "tsx stagehand/tests/explore-search.e2e.ts",
    "stagehand:recipe-detail": "tsx stagehand/tests/recipe-detail.e2e.ts",
    "stagehand:backend-crud": "tsx stagehand/tests/backend-crud.e2e.ts",
    "stagehand:categories": "tsx stagehand/tests/categories-tags.e2e.ts",
    "stagehand:favorites": "tsx stagehand/tests/favorites-bookmarks.e2e.ts",
    "cy:f1": "cypress run --spec 'cypress/e2e/funcionalidades/01-explore.cy.ts'",
    "cy:f2": "cypress run --spec 'cypress/e2e/funcionalidades/02-recipe-detail.cy.ts'",
    "cy:f3": "cypress run --spec 'cypress/e2e/funcionalidades/03-backend-crud.cy.ts'",
    "cy:f4": "cypress run --spec 'cypress/e2e/funcionalidades/04-categories.cy.ts'",
    "cy:f5": "cypress run --spec 'cypress/e2e/funcionalidades/05-favorites.cy.ts'",
    "cy:funcionalidades": "cypress run --spec 'cypress/e2e/funcionalidades/**/*.cy.ts'",
    "cy:all": "cypress run",
    "postman:run": "newman run postman/CocinaCompartida.postman_collection.json --env-var baseUrl=http://localhost",
    "postman:run:html": "newman run postman/CocinaCompartida.postman_collection.json --env-var baseUrl=http://localhost --reporters cli,htmlextra --reporter-htmlextra-export evidencias/postman-report.html",
    "groq:validate": "tsx groq-ai-validator/validate.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@google/genai": "^2.18.0",
    "@supabase/supabase-js": "^2.36.0",
    "alert": "^6.0.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "rxjs": "~7.8.0",
    "sweet": "^0.1.1",
    "sweetalert2": "^11.23.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "@applitools/eyes-cypress": "^3.60.1",
    "@browserbasehq/stagehand": "^3.4.0",
    "@types/jasmine": "~5.1.0",
    "@types/multer": "^2.1.0",
    "axe-core": "^4.10.0",
    "cypress": "^14.0.0",
    "cypress-axe": "^1.5.0",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.2.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript": "~5.9.2",
    "zod": "^4.4.3"
  }
}
